# PRAW Rule Management System - Local Files

# Backup directories (local deployment artifacts)
backups/

# Export files (generated content)
exports/

# Temporary files
*.tmp
*.temp

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Editor files
.vscode/
.idea/
*.swp
*.swo
*~

# Log files
*.log

# Local configuration overrides
local-config.*

# Anthropic document skills — source-available (not OSS), not bundled in this repo.
# Install on your machine via: npx skills add anthropics/skills --skill <name> -g
.agents/skills/docx/
.agents/skills/pdf/
.agents/skills/pptx/
.agents/skills/xlsx/

# yt-dlp skill — vendored from a third-party repo with no license declared; not redistributed here.
.agents/skills/yt-dlp/
# Python bytecode caches (any skill's scripts/)
__pycache__/
*.pyc

# ecosystem web: working folder, fetched sources and caches (see ecosystem/README.md)
ecosystem/.work/
ecosystem/build/data/el/hn/
ecosystem/build/data/gh_cache.json
ecosystem/build/data/drift-report.*
ecosystem/build/data/*_report.json

# hax.cloud site build output
_site/
