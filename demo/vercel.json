{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "bash build/build.sh",
  "outputDirectory": "_site",
  "rewrites": [
    {
      "source": "/elements/:path*",
      "destination": "/node_modules/@haxtheweb/:path*"
    },
    {
      "source": "/lib/themes.json",
      "destination": "/node_modules/@haxtheweb/haxcms-elements/lib/themes.json"
    },
    {
      "source": "/((?!.*\\.[A-Za-z0-9]+$).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
