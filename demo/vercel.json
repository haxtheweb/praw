{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "bash build/build.sh",
  "outputDirectory": "_site",
  "rewrites": [
    {
      "source": "/elements/:path*",
      "destination": "https://webcomponents.hax.cloud/elements/:path*"
    },
    {
      "source": "/node_modules/:path*",
      "destination": "https://webcomponents.hax.cloud/node_modules/:path*"
    },
    {
      "source": "/(.*\\.[A-Za-z0-9]+)",
      "destination": "https://webcomponents.hax.cloud/elements/haxcms-elements/demo/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    }
  ]
}
