 "tours": [
  {
   "id": "blocks",
   "label": "Blocks by what they do",
   "message": "The blocks authors can place in HAX, grouped the way the editor groups them, and tied to the course ontology branch each one serves.",
   "scenes": [
    {
     "caption": "Every block is a web component.",
     "nodes": [
      "components"
     ]
    },
    {
     "caption": "The editor groups blocks into six categories.",
     "nodes": [
      "cat_instructional",
      "cat_media",
      "cat_layout",
      "cat_content",
      "cat_text",
      "cat_other"
     ]
    },
    {
     "caption": "Instructional blocks: questions, self checks, vocabulary, math and timelines.",
