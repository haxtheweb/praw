    p_vitepress[["VitePress"]]
    p_quarto[["Quarto"]]
    p_pressbooks[["Pressbooks"]]
    p_openstax[["OpenStax"]]
    p_html[["Any HTML site"]]
    f_docx["DOCX"]
    f_pptx["PPTX"]
    f_pdf["PDF"]
    f_xlsx["XLSX"]
    f_html["HTML"]
    f_md["Markdown"]
    f_media["Images, audio, video"]
    f_url["A URL"]
    f_jos["JOS items (site.json)"]
  end
