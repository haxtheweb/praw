flowchart TB
  %%@ layout rings=0,210,430,680 sizes=92,64,54,50
  subgraph hub ["JSON Outline Schema"]
    jos[("jos")]
  end
  subgraph files ["Three schema files"]
    js_core[("json-outline-schema.schema.json")]
    js_site[("haxcms-site.schema.json")]
    js_skel[("skeleton.schema.json")]
  end
  subgraph partsg ["Parts"]
    jp_outline["the outline (id, title, author, license, metadata)"]
    jp_items["items"]
    ji_id["item.id"]
    ji_title["item.title"]
    ji_description["item.description"]
    ji_parent["item.parent"]
    ji_order["item.order"]
    ji_indent["item.indent"]
    ji_location["item.location"]
    ji_slug["item.slug"]
    ji_metadata["item.metadata"]
    jm_author["metadata.author"]
    jm_site["metadata.site"]
    jm_theme["metadata.theme"]
    jm_platform["metadata.platform"]
    jm_node["metadata.node"]
    jm_build["metadata.build"]
    jm_plugins["metadata.plugins"]
    jp_itemmeta["item.metadata"]
    jp_skelbuild["skeleton build.items"]
  end
  subgraph who ["Who reads and writes it"]
    outline["outline"]
    haxcms["haxcms"]
    editor["editor"]
    cli["cli"]
    hax11ty["hax11ty"]
    skeletons["skeletons"]
    importers["importers"]
    themes["themes"]
    mcp["mcp"]
    contracts["contracts"]
  end

  jos -.->|is defined by| js_core
  js_site -.->|extends| js_core
  js_skel -.->|extends| js_core
  js_core -->|defines| jp_outline
  js_core -->|defines| jp_items
  jp_items -->|each has| ji_id
  jp_items -->|each has| ji_title
  jp_items -->|each has| ji_description
  jp_items -->|each has| ji_parent
  jp_items -->|each has| ji_order
