    m_haxreg[("hax-elements-registry.json")]
    m_translations[("translation-manifest.json")]
    m_languages[("languages.json")]
  end
  subgraph stepsg ["Steps that write and read them"]
    st_wc_autoloader["6. wc-autoloader"]
    st_language_registry_sync["8. language-registry-sync"]
    st_hax_elements_discovery["9. hax-elements-discovery"]
    st_elements_catalog["10. elements-catalog"]
    st_hax_elements_demo_page["11. hax-elements-demo-page"]
    st_translation_manifest["13. translation-manifest"]
    st_language_registry_report["14. language-registry-report"]
