    pk_haxcms_elements["haxcms-elements"]
    pk_i18n_manager["i18n-manager"]
    pk_web_container["web-container"]
  end
  subgraph ctx ["Around it"]
    ubiquity["ubiquity"]
    components["components"]
    languages["languages"]
    efficient["efficient"]
  end

