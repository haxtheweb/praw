%% Release and build sub-web: how a HAX release goes out, generated from webcomponents scripts/ubiquity-push.sh and each repo's GitHub workflows.
flowchart TB
  %%@ layout rings=0,250,500,760 sizes=92,64,58,52
  subgraph hub ["Release and build"]
    ubiquity["ubiquity"]
  end
  subgraph stepsg ["The release, in order"]
    r0>"1. Publish packages"]
    r1>"2. Ubiquity build"]
    r2>"3. Agent skills index"]
    r3>"4. Normalize every project"]
    r4>"5. Sync themes.json"]
    r5>"6. Outline designer contract"]
    r6>"7. Node.js is the boilerplate"]
    r7>"8. Rebuild the gallery"]
    r8>"9. Version and tag everything"]
  end
  subgraph afterg ["When a tag lands"]
    rl_notes["Release notes and checksums"]
    rl_docker["Container images"]
    rl_sbom["Software bill of materials"]
    rl_npm["npm releases"]
    rl_vercel["Gallery previews"]
    rl_build["Nightly build and tests"]
    rl_parity["Backend parity"]
    rl_codeql["CodeQL and scorecards"]
  end
  subgraph dest ["Where it goes"]
    haxpsu["haxpsu"]
    npm["npm"]
    components["components"]
    praw["praw"]
    agents["agents"]
    hax11ty["hax11ty"]
    php["php"]
    nodejs["nodejs"]
    haxiam["haxiam"]
    rl_psucdn[("Penn State CDN")]
    elmsln["elmsln"]
    themes["themes"]
    outline["outline"]
    cli["cli"]
    github["github"]
  end

  ubiquity -->|starts with| r0
  r0 -->|then| r1
  r1 -->|then| r2
  r2 -->|then| r3
  r3 -->|then| r4
  r4 -->|then| r5
  r5 -->|then| r6
  r6 -->|then| r7
  r7 -->|then| r8
  r0 -.->|updates| npm
  r0 -.->|updates| components
