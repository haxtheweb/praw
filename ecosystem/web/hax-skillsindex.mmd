%% Agent skills index sub-web, generated by build_skillsindex.py from PRAW's .well-known/agent-skills and every copy in haxcms-nodejs and haxcms-php.
%% Portals: ids from hax-ecosystem.mmd (traveler opens the skills web). Details in hax-skillsindex.json.
flowchart TB
  %%@ layout rings=0,230,470,720,960 sizes=92,52,58,54,46
  subgraph hub ["Agent skills index"]
    skillsindex[("skillsindex")]
  end
  subgraph fieldsg ["Fields"]
    f_dollar_schema["$schema"]
    f_skills["skills"]
    f_name["name"]
    f_type["type"]
    f_description["description"]
    f_url["url"]
    f_digest["digest"]
    f_files["files"]
  end
  subgraph setsg ["Skill sets"]
    set_all["all of PRAW (52)"]
    set_site["site (5)"]
    set_system["system (25)"]
  end
  subgraph copiesg ["Files that conform"]
    praw_index[("praw .well-known index")]
    praw_full[("praw skills/index.json")]
    nodejs_site[("haxcms-nodejs site")]
    nodejs_system[("haxcms-nodejs system")]
    php_site[("haxcms-php site")]
    php_system[("haxcms-php system")]
  end
  subgraph rwg ["Readers, writers and owners"]
    w_build["build-agent-skills-index.js"]
    w_snapshot["snapshot-agent-skills.js"]
    w_php["HAXCMSSite.php"]
    w_node["app.js"]
    w_cli["site.js"]
    praw["praw"]
    nodejs["nodejs"]
    php["php"]
    cli["cli"]
    traveler["traveler"]
  end

  skillsindex -->|has| f_dollar_schema
  skillsindex -->|has| f_skills
  skillsindex -->|gives each skill a| f_name
  skillsindex -->|gives each skill a| f_type
  skillsindex -->|gives each skill a| f_description
  skillsindex -->|gives each skill a| f_url
  skillsindex -->|gives each skill a| f_digest
  skillsindex -->|gives each skill a| f_files
  skillsindex -->|is cut into| set_all
  set_all -->|narrows to| set_site
  set_all -->|narrows to| set_system
  praw_index -.->|conforms to| skillsindex
  praw_full -.->|conforms to| skillsindex
  praw_index -->|lists| set_all
  praw_full -->|lists| set_all
  nodejs_site -.->|conforms to| skillsindex
  nodejs_site -->|lists| set_site
  nodejs_system -.->|conforms to| skillsindex
  nodejs_system -->|lists| set_system
  php_site -.->|conforms to| skillsindex
  php_site -->|lists| set_site
  php_system -.->|conforms to| skillsindex
  php_system -->|lists| set_system
  w_build -->|writes| praw_index
  w_build -->|writes| praw_full
  praw --o|owns| w_build
  w_snapshot -->|copies a set into| nodejs_site
  w_snapshot -->|copies a set into| nodejs_system
  w_snapshot -->|copies a set into| php_site
  w_snapshot -->|copies a set into| php_system
  praw --o|owns| w_snapshot
  w_php -->|links and copies| php_site
  php --o|owns| w_php
  w_node -->|serves| nodejs_system
  nodejs --o|owns| w_node
  w_cli -->|keeps| nodejs_site
  w_cli -->|keeps| php_site
  cli --o|owns| w_cli
  traveler -->|offers its skills through| set_all

