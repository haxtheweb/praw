#!/bin/bash

# LinkedIn posting script for content automation
# Usage: ./linkedin [--post] [--custom "content"] [--help]
#
# Defaults to a dry run (generate and print the posts, publish nothing). Pass
# --post to actually publish; anything sourced from issue text or an AI
# conversation should be read by a person before that flag is added.

cd "$(dirname "$0")"

MODE_FLAG="--dry-run"
PASS_ARGS=()
for arg in "$@"; do
    case "$arg" in
        --post) MODE_FLAG="--post" ;;
        *) PASS_ARGS+=("$arg") ;;
    esac
done

echo "🚀 LinkedIn Content Poster"
echo "=============================="

# Check if we have issue management scripts available
if [[ -f "../issue-management/fetch_issues.sh" ]]; then
    echo "📊 Fetching latest issue data..."
    cd ../issue-management
    if ./fetch_issues.sh; then
        echo "✅ Data updated"
        cd - > /dev/null
    else
        echo "⚠️  Issue data update failed, continuing anyway..."
        cd - > /dev/null
    fi
else
    echo "💡 No issue data available - custom content mode only"
fi

# Run the LinkedIn poster with any provided arguments (dry run unless --post)
if [[ "$MODE_FLAG" == "--dry-run" ]]; then
    echo "🧪 Dry run (default). Pass --post to publish."
fi
node post-to-linkedin.js "$MODE_FLAG" "${PASS_ARGS[@]}"
