{
  "id": "generic-html",
  "label": "Platform-neutral HTML patterns",
  "$comment": "Applied after any platform or builder map, so specific maps win. See block-maps/README.md for the rule format.",
  "contentSelectors": ["main article", "article", "main", "[role=main]", "#content", ".content", "#main"],
  "chromeSelectors": ["script", "style", "noscript", "template", "header nav", "nav[aria-label*=breadcrumb i]", ".breadcrumb", ".breadcrumbs", ".skip-link", ".screen-reader-shortcut", ".share", ".sharing", ".social-share", "#comments", ".comments-area", ".cookie-banner", "#cookie-notice", ".visually-hidden-focusable"],
  "rules": [
    { "id": "youtube-iframe", "match": "iframe[src*='youtube.com/embed'], iframe[src*='youtube-nocookie.com/embed'], iframe[data-src*='youtube.com/embed']", "to": "video-player", "attrs": { "source": "@src|@data-src", "mediaTitle": "@title" }, "confidence": "high" },
    { "id": "vimeo-iframe", "match": "iframe[src*='player.vimeo.com'], iframe[data-src*='player.vimeo.com']", "to": "video-player", "attrs": { "source": "@src|@data-src", "mediaTitle": "@title" }, "confidence": "high" },
    { "id": "kaltura-iframe", "match": "iframe[src*='kaltura.com'], iframe[src*='mediaspace']", "to": "video-player", "attrs": { "source": "@src", "mediaTitle": "@title" }, "confidence": "medium", "note": "video-player accepts the embed URL; check playback for institution-locked Kaltura media." },
    { "id": "h5p-iframe", "match": "iframe[src*='h5p'], iframe.h5p-iframe", "to": "flag", "flag": "h5p", "confidence": "high", "note": "Replace with h5p-element pointing at the uploaded .h5p file; the embed itself cannot be converted." },
    { "id": "spotify-iframe", "match": "iframe[src*='open.spotify.com']", "to": "spotify-embed", "attrs": { "source": "@src" }, "confidence": "high" },
    { "id": "tableau-iframe", "match": "iframe[src*='tableau']", "to": "tableau-embed", "attrs": { "src": "@src" }, "confidence": "medium" },
    { "id": "pdf-iframe", "match": "iframe[src$='.pdf'], embed[src$='.pdf'], object[data$='.pdf']", "to": "pdf-browser-viewer", "attrs": { "file": "@src|@data" }, "confidence": "high", "asset": true },
    { "id": "map-iframe", "match": "iframe[src*='google.com/maps'], iframe[src*='openstreetmap.org']", "to": "iframe-loader", "attrs": { "source": "@src" }, "confidence": "medium" },
    { "id": "form-iframe", "match": "iframe[src*='docs.google.com/forms'], iframe[src*='forms.office.com'], iframe[src*='qualtrics'], iframe[src*='jotform']", "to": "flag", "flag": "form", "confidence": "high", "note": "Third-party form. Keep as a link or iframe-loader after a human checks it." },
    { "id": "other-iframe", "match": "iframe[src^='http']", "to": "iframe-loader", "attrs": { "source": "@src", "height": "@height", "width": "@width" }, "confidence": "low" },
    { "id": "html5-video", "match": "video", "to": "video-player", "attrs": { "source": "@src|source@src", "thumbnailSrc": "@poster" }, "confidence": "high", "asset": true },
    { "id": "html5-audio", "match": "audio", "to": "audio-player", "attrs": { "source": "@src|source@src" }, "confidence": "high", "asset": true },
    { "id": "twitter-embed", "match": "blockquote.twitter-tweet", "to": "twitter-embed", "attrs": { "tweet": "a[href*='/status/']@href" }, "confidence": "medium" },
    { "id": "details", "match": "details", "to": "a11y-collapse", "attrs": { "heading": "summary@text" }, "content": "@html-without:summary", "confidence": "high" },
    { "id": "figure-image", "match": "figure:has(> img), figure:has(> a > img), figure:has(> picture)", "to": "media-image", "attrs": { "source": "img@data-src|img@src", "alt": "img@alt", "caption": "figcaption@text", "link": "a@href" }, "confidence": "high", "asset": true },
    { "id": "bare-image", "match": "img", "to": "media-image", "attrs": { "source": "@data-src|@src", "alt": "@alt" }, "confidence": "high", "asset": true, "skipInside": ["a", "button", "svg"] },
    { "id": "code-block", "match": "pre:has(> code)", "to": "code-sample", "attrs": { "type": "code@class~language-(\\w+)" }, "content": "code@raw-template", "confidence": "high" },
    { "id": "math", "match": ".katex-display, .MathJax_Display, mjx-container[display=true], math[display=block]", "to": "lrn-math", "attrs": { "mathtext": "annotation[encoding='application/x-tex']@text|@data-latex" }, "confidence": "medium" },
    { "id": "callout-warning", "match": ".alert-warning, .callout-warning, .admonition.warning, .notice--warning, .note.warning", "to": "stop-note", "attrs": { "status": "=warning", "title": ".admonition-title@text|strong@text" }, "slots": { "message": "@html" }, "confidence": "medium" },
    { "id": "callout-danger", "match": ".alert-danger, .callout-danger, .admonition.danger, .admonition.caution, .notice--danger", "to": "stop-note", "attrs": { "status": "=stop", "title": ".admonition-title@text|strong@text" }, "slots": { "message": "@html" }, "confidence": "medium" },
    { "id": "callout-success", "match": ".alert-success, .callout-success, .admonition.tip, .admonition.success, .notice--success", "to": "stop-note", "attrs": { "status": "=success", "title": ".admonition-title@text|strong@text" }, "slots": { "message": "@html" }, "confidence": "medium" },
    { "id": "callout-info", "match": ".alert-info, .callout-info, .callout, .admonition, .notice, aside.note", "to": "stop-note", "attrs": { "status": "=info", "title": ".admonition-title@text|strong@text" }, "slots": { "message": "@html" }, "confidence": "low" },
    { "id": "button-link", "match": "a.btn, a.button, a[class*='btn-'], a[role=button]", "to": "simple-cta", "attrs": { "link": "@href", "label": "@text" }, "confidence": "medium" },
    { "id": "pdf-link", "match": "a[href$='.pdf'], a[href*='.pdf?']", "to": "keep", "asset": true, "confidence": "high", "note": "Link kept; the PDF is added to the file map." },
    { "id": "ics-link", "match": "a[href$='.ics']", "to": "keep", "asset": true, "confidence": "high", "note": "Could become ics-render." },
    { "id": "data-table", "match": "table", "to": "keep", "confidence": "high", "note": "Native table. editable-table can wrap it later if sorting or filtering is wanted." },
    { "id": "form", "match": "form", "to": "flag", "flag": "form", "confidence": "high", "note": "Forms post somewhere; HAX content cannot carry them. Needs a human decision (link out, embed, or a plugin)." },
    { "id": "social-embed-script", "match": ".fb-page, .fb-post, iframe[src*='facebook.com/plugins']", "to": "link", "attrs": { "href": "@data-href|@src" }, "confidence": "high", "note": "Third-party widgets become plain links." }
  ]
}
