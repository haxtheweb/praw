{
  "id": "wordpress-elementor",
  "label": "Elementor widgets",
  "source": "https://elementor.com/help/widgets/",
  "$comment": "Elementor renders every widget as .elementor-widget-<name> wrapping .elementor-widget-container. Older layouts use .elementor-section > .elementor-container > .elementor-column; newer ones use flex containers (.e-con).",
  "contentSelectors": ["[data-elementor-type=wp-page]", "[data-elementor-type=wp-post]", ".elementor[data-elementor-id]", ".entry-content"],
  "chromeSelectors": ["[data-elementor-type=header]", "[data-elementor-type=footer]", "[data-elementor-type=popup]", ".elementor-location-header", ".elementor-location-footer", ".elementor-widget-nav-menu", ".elementor-widget-spacer", ".elementor-widget-share-buttons", ".elementor-widget-search-form"],
  "rules": [
    { "id": "section-columns", "match": ".elementor-section:has(> .elementor-container > .elementor-column ~ .elementor-column)", "to": "grid-plate", "layout": "auto", "children": { "select": ".elementor-column", "slot": "col-{n}", "content": "@html" }, "confidence": "medium", "note": "Equal layout guessed; Elementor column widths are in .elementor-col-NN classes." },
    { "id": "container-row", "match": ".e-con.e-parent:has(> .e-con-inner > .e-con.e-child ~ .e-con.e-child), .e-con.e-parent:has(> .e-con.e-child ~ .e-con.e-child)", "to": "grid-plate", "layout": "auto", "children": { "select": ".e-con.e-child", "slot": "col-{n}", "content": "@html" }, "confidence": "low", "note": "Flex containers may stack vertically; check rows vs. columns." },
    { "id": "section", "match": ".elementor-section, .e-con, .elementor-column, .elementor-widget-wrap, .elementor-container, .e-con-inner", "to": "unwrap", "confidence": "high" },
    { "id": "heading", "match": ".elementor-widget-heading", "to": "unwrap", "confidence": "high" },
    { "id": "text-editor", "match": ".elementor-widget-text-editor", "to": "unwrap", "confidence": "high" },
    { "id": "image", "match": ".elementor-widget-image", "to": "media-image", "attrs": { "source": "img@data-src|img@src", "alt": "img@alt", "caption": "figcaption@text", "link": "a@href" }, "confidence": "high", "asset": true },
    { "id": "video", "match": ".elementor-widget-video", "to": "video-player", "attrs": { "source": "@data-settings#youtube_url|@data-settings#vimeo_url|iframe@src|video@src" }, "confidence": "high" },
    { "id": "button", "match": ".elementor-widget-button", "to": "simple-cta", "attrs": { "link": "a.elementor-button@href|a@href", "label": ".elementor-button-text@text|a@text" }, "confidence": "high" },
    { "id": "image-box", "match": ".elementor-widget-image-box", "to": "ddd-card", "attrs": { "src": "img@src", "alt": "img@alt", "title": ".elementor-image-box-title@text", "href": "a@href" }, "content": ".elementor-image-box-description@html", "confidence": "medium", "asset": true },
    { "id": "icon-box", "match": ".elementor-widget-icon-box", "to": "accent-card", "slots": { "heading": ".elementor-icon-box-title@text", "content": ".elementor-icon-box-description@html" }, "confidence": "low", "note": "Icon is dropped; HAX icons differ from Elementor's icon fonts." },
    { "id": "testimonial", "match": ".elementor-widget-testimonial", "to": "person-testimonial", "attrs": { "image": "img@src", "name": ".elementor-testimonial-name@text", "position": ".elementor-testimonial-job@text" }, "content": ".elementor-testimonial-content@html", "confidence": "high", "asset": true },
    { "id": "counter", "match": ".elementor-widget-counter", "to": "count-up", "attrs": { "end": ".elementor-counter-number@data-to-value", "start": ".elementor-counter-number@data-from-value", "prefixtext": ".elementor-counter-number-prefix@text", "suffixtext": ".elementor-counter-number-suffix@text" }, "confidence": "high" },
    { "id": "accordion", "match": ".elementor-widget-accordion, .elementor-widget-toggle, .elementor-widget-n-accordion", "to": "a11y-collapse-group", "children": { "select": ".elementor-accordion-item, .elementor-toggle-item, details.e-n-accordion-item", "to": "a11y-collapse", "attrs": { "heading": ".elementor-tab-title@text|summary@text" }, "content": ".elementor-tab-content@html|@html-without:summary" }, "confidence": "high" },
    { "id": "tabs", "match": ".elementor-widget-tabs, .elementor-widget-n-tabs", "to": "a11y-tabs", "children": { "select": ".elementor-tab-content, .e-n-tabs-content > div", "to": "a11y-tab", "attrs": { "label": "@data-tab-title|@aria-label" }, "content": "@html" }, "confidence": "low", "note": "Tab titles live in a separate list; check labels after conversion." },
    { "id": "gallery", "match": ".elementor-widget-image-gallery, .elementor-widget-gallery, .elementor-widget-image-carousel", "to": "image-gallery", "children": { "select": "img", "to": "media-image", "attrs": { "source": "@data-src|@src", "alt": "@alt" } }, "confidence": "high", "asset": true },
    { "id": "alert", "match": ".elementor-widget-alert", "to": "stop-note", "attrs": { "status": "=info", "title": ".elementor-alert-title@text" }, "slots": { "message": ".elementor-alert-description@html" }, "confidence": "medium" },
    { "id": "divider", "match": ".elementor-widget-divider", "to": "html", "html": "<hr>", "confidence": "high" },
    { "id": "icon-list", "match": ".elementor-widget-icon-list", "to": "unwrap", "confidence": "medium" },
    { "id": "google-maps", "match": ".elementor-widget-google_maps", "to": "iframe-loader", "attrs": { "source": "iframe@src" }, "confidence": "medium" },
    { "id": "html", "match": ".elementor-widget-html", "to": "flag", "flag": "custom-html", "confidence": "high", "note": "Hand-written HTML/JS; review before keeping." },
    { "id": "shortcode", "match": ".elementor-widget-shortcode", "to": "flag", "flag": "shortcode", "confidence": "high" },
    { "id": "form", "match": ".elementor-widget-form", "to": "flag", "flag": "form", "confidence": "high" },
    { "id": "posts", "match": ".elementor-widget-posts, .elementor-widget-portfolio, .elementor-widget-loop-grid", "to": "flag", "flag": "dynamic-listing", "confidence": "high" },
    { "id": "call-to-action", "match": ".elementor-widget-call-to-action", "to": "flag", "flag": "gap", "confidence": "high", "note": "Background image + title + text + button; candidate for a page-section preset." },
    { "id": "progress", "match": ".elementor-widget-progress", "to": "flag", "flag": "gap", "confidence": "high" },
    { "id": "social-icons", "match": ".elementor-widget-social-icons", "to": "keep", "confidence": "medium" }
  ]
}
