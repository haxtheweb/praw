{
  "id": "wordpress-gutenberg",
  "label": "WordPress core blocks (Gutenberg)",
  "source": "https://developer.wordpress.org/block-editor/reference-guides/core-blocks/",
  "contentSelectors": [".wp-block-post-content", ".entry-content", "article .post-content", ".page-content", "article"],
  "chromeSelectors": [".sharedaddy", ".jp-relatedposts", ".wp-block-post-navigation-link", ".wp-block-comments", ".post-navigation", ".wp-block-query-pagination"],
  "rules": [
    { "id": "core/columns", "match": ".wp-block-columns", "to": "grid-plate", "layout": "auto", "children": { "select": ".wp-block-column", "slot": "col-{n}", "content": "@html" }, "confidence": "high" },
    { "id": "core/media-text", "match": ".wp-block-media-text", "to": "grid-plate", "attrs": { "layout": "=1-1" }, "children": { "select": ".wp-block-media-text__media, .wp-block-media-text__content", "slot": "col-{n}", "content": "@html" }, "confidence": "high" },
    { "id": "core/group", "match": ".wp-block-group", "to": "unwrap", "confidence": "high" },
    { "id": "core/cover", "match": ".wp-block-cover", "to": "page-section", "attrs": { "image": "img.wp-block-cover__image-background@src|@data-bg" }, "content": ".wp-block-cover__inner-container@html", "confidence": "medium", "asset": true },
    { "id": "core/gallery", "match": "figure.wp-block-gallery, .wp-block-gallery", "to": "image-gallery", "children": { "select": "figure.wp-block-image, li.blocks-gallery-item", "to": "media-image", "attrs": { "source": "img@data-src|img@src", "alt": "img@alt", "caption": "figcaption@text" } }, "confidence": "high", "asset": true },
    { "id": "core/image", "match": "figure.wp-block-image, .wp-block-image", "to": "media-image", "attrs": { "source": "img@data-src|img@src", "alt": "img@alt", "caption": "figcaption@text", "link": "a@href" }, "confidence": "high", "asset": true },
    { "id": "core/embed-youtube", "match": ".wp-block-embed-youtube, figure.is-provider-youtube", "to": "video-player", "attrs": { "source": "iframe@src|.wp-block-embed__wrapper@text", "mediaTitle": "iframe@title" }, "confidence": "high" },
    { "id": "core/embed-vimeo", "match": ".wp-block-embed-vimeo, figure.is-provider-vimeo", "to": "video-player", "attrs": { "source": "iframe@src|.wp-block-embed__wrapper@text", "mediaTitle": "iframe@title" }, "confidence": "high" },
    { "id": "core/embed-twitter", "match": ".wp-block-embed-twitter, figure.is-provider-twitter", "to": "twitter-embed", "attrs": { "tweet": "a[href*='/status/']@href|.wp-block-embed__wrapper@text" }, "confidence": "medium" },
    { "id": "core/embed-spotify", "match": ".wp-block-embed-spotify", "to": "spotify-embed", "attrs": { "source": "iframe@src" }, "confidence": "high" },
    { "id": "core/embed-other", "match": ".wp-block-embed", "to": "link", "attrs": { "href": "iframe@src|.wp-block-embed__wrapper@text" }, "confidence": "low", "note": "Unknown oEmbed provider; kept as a link." },
    { "id": "core/video", "match": "figure.wp-block-video", "to": "video-player", "attrs": { "source": "video@src", "thumbnailSrc": "video@poster" }, "confidence": "high", "asset": true },
    { "id": "core/audio", "match": "figure.wp-block-audio", "to": "audio-player", "attrs": { "source": "audio@src" }, "confidence": "high", "asset": true },
    { "id": "core/file", "match": ".wp-block-file", "to": "keep", "asset": true, "confidence": "high", "note": "Download link kept; file added to the file map. PDFs with an embedded viewer could become pdf-browser-viewer." },
    { "id": "core/buttons", "match": ".wp-block-buttons", "to": "unwrap", "confidence": "high" },
    { "id": "core/button", "match": ".wp-block-button", "to": "simple-cta", "attrs": { "link": "a@href", "label": "a@text" }, "confidence": "high" },
    { "id": "core/quote", "match": "blockquote.wp-block-quote, figure.wp-block-pullquote", "to": "block-quote", "attrs": { "citation": "cite@text" }, "content": "@html-without:cite", "confidence": "high" },
    { "id": "core/details", "match": "details.wp-block-details", "to": "a11y-collapse", "attrs": { "heading": "summary@text" }, "content": "@html-without:summary", "confidence": "high" },
    { "id": "core/code", "match": "pre.wp-block-code, pre.wp-block-preformatted", "to": "code-sample", "content": "@raw-template", "confidence": "high" },
    { "id": "core/table", "match": "figure.wp-block-table", "to": "unwrap", "confidence": "high", "note": "Native table inside is kept." },
    { "id": "core/separator", "match": "hr.wp-block-separator", "to": "keep", "confidence": "high" },
    { "id": "core/spacer", "match": ".wp-block-spacer", "to": "drop", "confidence": "high" },
    { "id": "core/latest-posts", "match": ".wp-block-latest-posts, .wp-block-query, .wp-block-post-template", "to": "flag", "flag": "dynamic-listing", "confidence": "high", "note": "Generated post listing; becomes a HAX views/collection listing, not static content." },
    { "id": "core/social-links", "match": ".wp-block-social-links", "to": "keep", "confidence": "medium" },
    { "id": "core/search", "match": ".wp-block-search", "to": "drop", "confidence": "high" },
    { "id": "core/navigation", "match": ".wp-block-navigation, .wp-block-page-list", "to": "drop", "confidence": "high" }
  ]
}
