{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "bash ecosystem/build/site.sh",
  "outputDirectory": "_site",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/demo",
      "destination": "https://webcomponents.hax.cloud/elements/haxcms-elements/demo/index.html",
      "permanent": false
    },
    {
      "source": "/magicscript.html",
      "destination": "/magic-script",
      "permanent": true
    },
    {
      "source": "/docplayer.html",
      "destination": "https://webcomponents.hax.cloud",
      "permanent": true
    }
  ]
}
