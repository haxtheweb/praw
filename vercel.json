{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "bash ecosystem/build/site.sh",
  "outputDirectory": "_site",
  "rewrites": [
    {
      "source": "/((?!system/)(?!.*\\.[A-Za-z0-9]+$).*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/demo",
      "destination": "https://browser.hax.cloud/",
      "permanent": false
    },
    {
      "source": "/magicscript.html",
      "destination": "/magic-script",
      "permanent": true
    },
    {
      "source": "/docplayer.html",
      "destination": "https://webcomponents.hax.cloud",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ]
}
